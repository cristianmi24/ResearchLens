# ResearchLens - plantilla de variables de entorno
#
# Local: copia este archivo a `.env` (en la raíz) y completa los valores.
# Vercel: crea estas mismas variables en Settings -> Environment Variables.
# NUNCA subas el `.env` real al repositorio.

# =============================================================================
# FRONTEND (Vite) — solo lo que empieza con VITE_ llega al navegador
# =============================================================================

# Clave PÚBLICA de Clerk (empieza con pk_). Sin ella se ocultan los botones de login social.
VITE_CLERK_PUBLISHABLE_KEY=

# URL del backend. En Vercel NO la definas (usa "/api" por defecto).
# Solo en local si corres frontend y backend por separado, por ejemplo:
# VITE_API_BASE_URL=http://localhost:8787/api

# =============================================================================
# BACKEND (Express) — secretas, nunca con prefijo VITE_
# =============================================================================

# --- Obligatorias -------------------------------------------------------------
# IA (Qwen / Alibaba DashScope)
QWEN_API_KEY=
# Base de datos Postgres (Neon): postgresql://usuario:clave@host/db?sslmode=require
DATABASE_URL=
# Secreto para firmar los JWT de sesión (usa una cadena larga y aleatoria)
JWT_SECRET=
# Clerk (clave SECRETA, empieza con sk_). Necesaria si usas login social.
CLERK_SECRET_KEY=

# --- Recomendadas -------------------------------------------------------------
# Tu correo: OpenAlex y Crossref lo piden para darte mejor cuota ("polite pool")
OPENALEX_MAILTO=
CROSSREF_MAILTO=
# Videos relacionados (YouTube Data API v3 habilitada en Google Cloud)
YOUTUBE_API_KEY=

# --- Opcionales ---------------------------------------------------------------
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Duración de la sesión (por defecto 7d)
JWT_EXPIRES_IN=7d
# Máximo de análisis por usuario por día (por defecto 15)
DAILY_ANALYSIS_LIMIT=15
# Cambiar solo si usas otro endpoint
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.7-flash
# QWEN_EMBEDDING_MODEL=text-embedding-v3
# ARXIV_API_BASE_URL=http://export.arxiv.org/api/query
# DOAJ_API_BASE_URL=https://doaj.org/api
# Puerto del backend en local (por defecto 8787; Vercel lo ignora)
# PORT=8787
